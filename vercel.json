{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"service-doc\"; type=\"text/markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
      "destination": "/index.md",
      "permanent": false
    },
    {
      "source": "/:page([a-z0-9-]+).html",
      "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
      "destination": "/:page.md",
      "permanent": false
    },
    {
      "source": "/:page([a-z0-9-]+)",
      "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
      "destination": "/:page.md",
      "permanent": false
    },
    {
      "source": "/open-source-vs-source-available.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/open-source-vs-source-available.md",
      "destination": "/index.md",
      "permanent": true
    }
  ]
}
